# ForgeFit environment template. Copy to .env.local and fill in with values from
# your Firebase project settings. The app builds and runs with these ABSENT; it
# then shows a friendly "Firebase not configured" state (no crash, no spinner).

# --- Required: all six activate auth / Firestore / Storage (NFR-1, C.2) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Optional ---
# App Check (reCAPTCHA v3). When absent, App Check is skipped entirely.
NEXT_PUBLIC_APPCHECK_SITE_KEY=
# Firebase Analytics measurement id. When absent, Analytics is skipped.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Dev-only App Check debug token path:
# In local dev, set `self.FIREBASE_APPCHECK_DEBUG_TOKEN = true` (or a token
# string) in the browser before init to use the App Check debug provider.
# FIREBASE_APPCHECK_DEBUG_TOKEN=
